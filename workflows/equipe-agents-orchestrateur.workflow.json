{
  "name": "Equipe agents - Orchestrateur (squelette)",
  "nodes": [
    {
      "parameters": {
        "content": "## Squelette non opérationnel\nContrat attendu de `agent-runner --role <po|archi|dev|qa|ba> --workdir <dossier> [--round N]` : imprime UNE ligne JSON sur stdout :\n`{\"ok\":true,\"tokens\":1234,\"summary\":\"...\",\"verdict\":\"ok|ko\"}` (verdict seulement pour qa).\nLes échanges passent par des fichiers dans le workdir ; n8n ne transmet que des résumés.\nA REMPLACER : credential SSH, chat id Telegram, texte du brief dans `Config`.\nErreur = workflow W0 (réglage Error workflow).",
        "height": 260,
        "width": 520
      },
      "id": "c1000000-0000-4000-8000-000000000000",
      "name": "Lisez-moi",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, -320]
    },
    {
      "parameters": {},
      "id": "c1000000-0000-4000-8000-000000000001",
      "name": "Démarrer",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const brief = 'Décrire ici la demande (ex. : application de suivi de pronostics)';\nconst requestId = 'req-' + Date.now();\nreturn [{ json: { requestId, brief, briefB64: Buffer.from(brief).toString('base64'), workdir: '/srv/agents/work/' + requestId, maxLoops: 3, budgetTokens: 200000, paused: false, loop: 0, tokens: 0 } }];"
      },
      "id": "c1000000-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            { "id": "d1000000-0000-4000-8000-000000000001", "leftValue": "={{ $json.paused }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000003",
      "name": "Pause globale ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [440, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "REMPLACER_PAR_TON_CHAT_ID",
        "text": "⏸ Equipe agents : pause globale active, aucune demande lancée.",
        "additionalFields": {}
      },
      "id": "c1000000-0000-4000-8000-000000000004",
      "name": "Notif pause",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, -140]
    },
    {
      "parameters": {
        "command": "={{ 'mkdir -p ' + $json.workdir + ' && echo ' + $json.briefB64 + ' | base64 -d > ' + $json.workdir + '/brief.md && agent-runner --role po --workdir ' + $json.workdir }}"
      },
      "id": "c1000000-0000-4000-8000-000000000005",
      "name": "Agent PO",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [660, 60]
    },
    {
      "parameters": {
        "jsCode": "const st = $('Config').first().json;\nlet out; try { out = JSON.parse($input.first().json.stdout); } catch (e) { throw new Error('Sortie agent PO illisible'); }\nif (!out.ok) throw new Error('Agent PO en échec : ' + (out.error || 'inconnu'));\nconst tokens = st.tokens + (out.tokens || 0);\nif (tokens > st.budgetTokens) throw new Error('Budget tokens dépassé : ' + tokens);\nreturn [{ json: { ...st, tokens, po: out.summary || '' } }];"
      },
      "id": "c1000000-0000-4000-8000-000000000006",
      "name": "Lire PO",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 60]
    },
    {
      "parameters": {
        "command": "={{ 'agent-runner --role archi --workdir ' + $json.workdir }}"
      },
      "id": "c1000000-0000-4000-8000-000000000007",
      "name": "Agent Archi",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [1100, 60]
    },
    {
      "parameters": {
        "jsCode": "const st = $('Lire PO').first().json;\nlet out; try { out = JSON.parse($input.first().json.stdout); } catch (e) { throw new Error('Sortie agent Archi illisible'); }\nif (!out.ok) throw new Error('Agent Archi en échec : ' + (out.error || 'inconnu'));\nconst tokens = st.tokens + (out.tokens || 0);\nif (tokens > st.budgetTokens) throw new Error('Budget tokens dépassé : ' + tokens);\nreturn [{ json: { ...st, tokens, archi: out.summary || '' } }];"
      },
      "id": "c1000000-0000-4000-8000-000000000008",
