        "approvalOptions": { "values": { "approvalType": "double", "approveLabel": "Approuver", "disapproveLabel": "Refuser" } },
        "options": { "limitWaitTime": { "values": { "resumeAmount": 24, "resumeUnit": "hours" } } }
