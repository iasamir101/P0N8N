    {
      "parameters": {
        "jsCode": "const st = $('Lire Dev').first().json;\nlet out; try { out = JSON.parse($input.first().json.stdout); } catch (e) { throw new Error('Sortie agent QA illisible'); }\nif (!out.ok) throw new Error('Agent QA en échec : ' + (out.error || 'inconnu'));\nconst tokens = st.tokens + (out.tokens || 0);\nif (tokens > st.budgetTokens) throw new Error('Budget tokens dépassé : ' + tokens);\nconst qaOk = out.verdict === 'ok';\nreturn [{ json: { ...st, tokens, qa: out.summary || '', qaOk, loop: qaOk ? st.loop : st.loop + 1 } }];"
      },
