{
  "name": "IA4 - Scores quotidiens",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "days", "triggerAtHour": 7 } ] }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Chaque matin 07h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "// CONFIG : code de la compétition football-data.org (PL, FL1, PD, SA, BL1, WC...)\nconst competition = 'PL';\nconst fmt = d => d.toLocaleDateString('sv-SE', { timeZone: 'Europe/Paris' });\nconst now = new Date();\nconst yesterday = new Date(now.getTime() - 24 * 3600 * 1000);\nreturn [{ json: { competition, dateFrom: fmt(yesterday), dateTo: fmt(now) } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Dates et compétition",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "=https://api.football-data.org/v4/competitions/{{ $json.competition }}/matches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "dateFrom", "value": "={{ $json.dateFrom }}" },
            { "name": "dateTo", "value": "={{ $json.dateTo }}" },
            { "name": "status", "value": "FINISHED" }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Matchs terminés",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [440, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const matches = $input.first().json.matches || [];\n// Aucun match terminé : le workflow s'arrête ici sans message.\nreturn matches.map(m => ({ json: {\n  match_id: m.id,\n  match_date: m.utcDate,\n  home_team: m.homeTeam.name,\n  away_team: m.awayTeam.name,\n  home_score: m.score.fullTime.home,\n  away_score: m.score.fullTime.away\n} }));"
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "resource": "database",
        "operation": "upsert",
        "schema": { "__rl": true, "value": "public", "mode": "name" },
        "table": { "__rl": true, "value": "matches", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "match_id": "={{ $json.match_id }}",
            "match_date": "={{ $json.match_date }}",
            "home_team": "={{ $json.home_team }}",
            "away_team": "={{ $json.away_team }}",
            "home_score": "={{ $json.home_score }}",
            "away_score": "={{ $json.away_score }}"
          },
          "matchingColumns": ["match_id"],
          "schema": []
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Enregistre les scores",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [880, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendTemplate",
        "phoneNumberId": "REMPLACER_PAR_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "REMPLACER_PAR_TON_NUMERO",
        "template": "scores_ok|fr",
        "components": {
          "component": [
            {
              "type": "body",
              "bodyParameters": {
                "parameter": [
                  { "type": "text", "text": "={{ $input.all().length }} match(s) enregistré(s) pour le {{ $('Dates et compétition').first().json.dateFrom }}" }
                ]
              }
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "WhatsApp OK",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [1100, 0],
      "executeOnce": true
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendTemplate",
        "phoneNumberId": "REMPLACER_PAR_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "REMPLACER_PAR_TON_NUMERO",
        "template": "scores_alerte|fr",
        "components": {
          "component": [
            {
              "type": "body",
              "bodyParameters": {
                "parameter": [
                  { "type": "text", "text": "={{ $json.error?.message || 'erreur inconnue' }}" }
                ]
              }
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "WhatsApp Alerte",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [880, 220],
      "executeOnce": true
    }
  ],
  "connections": {
    "Chaque matin 07h": { "main": [ [ { "node": "Dates et compétition", "type": "main", "index": 0 } ] ] },
    "Dates et compétition": { "main": [ [ { "node": "Matchs terminés", "type": "main", "index": 0 } ] ] },
    "Matchs terminés": { "main": [ [ { "node": "Normalise", "type": "main", "index": 0 } ], [ { "node": "WhatsApp Alerte", "type": "main", "index": 0 } ] ] },
    "Normalise": { "main": [ [ { "node": "Enregistre les scores", "type": "main", "index": 0 } ] ] },
    "Enregistre les scores": { "main": [ [ { "node": "WhatsApp OK", "type": "main", "index": 0 } ], [ { "node": "WhatsApp Alerte", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Europe/Paris" }
}
